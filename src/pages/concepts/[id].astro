---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BindingPanel from '../../components/BindingPanel.astro';
import MappingBadge from '../../components/MappingBadge.astro';
import { inlineMd } from '../../lib/inline';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((c) => ({ params: { id: c.id }, props: { concept: c } }));
}

const { concept } = Astro.props;
const { data } = concept;
const { Content } = await render(concept);

const all = await getCollection('concepts');
const related = data.related
  .map((id: string) => all.find((c) => c.id === id))
  .filter(Boolean);

// Unity on the left: most readers arrive knowing Unity and looking for Godot.
const order = ['unity', 'godot'];
const bindings = [...data.bindings].sort(
  (a, b) => order.indexOf(a.engine) - order.indexOf(b.engine)
);
const legacy = (await getCollection('legacy')).filter((l) => l.data.replacedBy === concept.id);
---
<Base title={`${data.title} — gdref`} description={data.summary}>
  <article data-pagefind-body>
    <p style="margin:0 0 .4rem"><a href="/concepts/" style="font-size:.86rem">&larr; Concepts</a></p>
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>
    <p><MappingBadge kind={data.mappingKind} /></p>

    {data.mappingKind === 'none' && (
      <div class="callout">
        <strong>No first-party equivalent</strong>
        <span set:html={inlineMd(data.gap)} />
      </div>
    )}

    {bindings.length > 0 && (
      <div class="pair">
        {bindings.map((b: any) => <BindingPanel binding={b} />)}
      </div>
    )}

    {data.migration && (
      <>
        <h2>Porting notes</h2>
        <div class="pair">
          {data.migration.fromUnity && (
            <div class="panel">
              <header><strong>Unity &rarr; Godot</strong></header>
              <p class="note" set:html={inlineMd(data.migration.fromUnity)} />
            </div>
          )}
          {data.migration.fromGodot && (
            <div class="panel">
              <header><strong>Godot &rarr; Unity</strong></header>
              <p class="note" set:html={inlineMd(data.migration.fromGodot)} />
            </div>
          )}
        </div>
      </>
    )}

    <Content />

    {legacy.length > 0 && (
      <>
        <h2>Legacy Unity symbols that land here</h2>
        <ul class="chips">
          {legacy.map((l) => <li><a href={`/legacy/${l.id}/`}>{l.data.symbol}</a></li>)}
        </ul>
      </>
    )}

    {related.length > 0 && (
      <>
        <h2>Related</h2>
        <ul class="chips">
          {related.map((c: any) => <li><a href={`/concepts/${c.id}/`}>{c.data.title}</a></li>)}
        </ul>
      </>
    )}
  </article>
</Base>
