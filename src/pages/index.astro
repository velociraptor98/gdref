---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import MappingBadge from '../components/MappingBadge.astro';

const concepts = (await getCollection('concepts')).filter((c) => !c.data.draft);
const recipes = (await getCollection('recipes')).filter((r) => !r.data.draft);
const categories = new Set(concepts.map((c) => c.data.category)).size;
const groups = new Set(recipes.map((r) => r.data.group)).size;

const featured = ['components-vs-nodes', 'input-actions', 'character-movement', 'gdscript-vs-csharp', 'spawn-object']
  .map((id) => concepts.find((c) => c.id === id))
  .filter(Boolean);
---
<Base
  title="gdref — Unity ⇄ Godot reference"
  description="A Rosetta stone for developers moving between Unity 6 and Godot 4, plus Godot recipes for common tasks."
>
  <div class="wrap hero">
    <h1>Unity ⇄ Godot,<br />side by side</h1>
    <p class="lede">
      You know how to do it in one engine. This tells you how to say it in the other —
      with honest notes where they do not line up.
    </p>
  </div>

  <div class="wrap">
    <div class="stats">
      <a class="stat" href="/concepts/">
        <span class="lbl stat-n">{concepts.length}</span>
        <span class="stat-name">Concepts</span>
        <span class="stat-sub">{categories} categories</span>
      </a>
      <div class="gutter"></div>
      <a class="stat" href="/recipes/">
        <span class="lbl stat-n">{recipes.length}</span>
        <span class="stat-name">Recipes</span>
        <span class="stat-sub">Godot only · {groups} groups</span>
      </a>
    </div>
  </div>

  <div class="wrap sec">
    <div class="lbl head">Start here</div>
    <div class="rows">
      {featured.map((c: any) => (
        <a class="row" href={`/concepts/${c.id}/`}>
          <span class="row-title">{c.data.title}</span>
          <MappingBadge kind={c.data.mappingKind} />
        </a>
      ))}
    </div>
  </div>

  <div class="wrap sec">
    <div class="lbl head">Scope</div>
    <p class="scope">
      <strong>Unity 6</strong>, modern APIs only — Input System, <code>Awaitable</code>, URP.
      Legacy symbols like <code>Input.GetAxis</code> stay searchable and point at the current
      equivalent, but never appear in the tables.
    </p>
    <p class="scope">
      Unity to Godot is the migration people are actually making, and two columns fit on a
      phone. Adding a third engine would cost both.
    </p>
  </div>

  <style>
    .hero { padding-block: 26px 18px; }
    .sec { padding-block: 18px 4px; }
    .head { color: var(--n-400); margin-bottom: 6px; }
    .scope { font-size: 13px; color: var(--n-300); max-width: 78ch; }
  </style>
</Base>
