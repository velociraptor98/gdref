---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — gdref" description="That page does not exist.">
  <div class="band">
    <div class="wrap">
      <div class="lbl crumb">404</div>
      <h1>Not found</h1>
    </div>
  </div>
  <div class="wrap body">
    <p class="lede">
      That page does not exist. It may have moved — the Godot API browser was removed in
      favour of the official docs.
    </p>
    <ul class="chips">
      <li><a href="/concepts/">Concepts</a></li>
      <li><a href="/recipes/">Recipes</a></li>
      <li><a href="/search/">Search</a></li>
      <li><a href="https://docs.godotengine.org/en/stable/classes/" rel="noopener">Godot class reference ↗</a></li>
    </ul>
  </div>
  <style>
    .body { padding-block: 18px 0; }
    .band { padding-block: 26px 18px; }
  </style>
</Base>
