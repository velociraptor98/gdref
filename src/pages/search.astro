---
import Base from '../layouts/Base.astro';
---
<Base title="Search — gdref" description="Search concepts, Godot recipes, and legacy Unity symbols.">
  <div class="band">
    <div class="wrap">
      <div class="lbl crumb">Search</div>
      <h1>Find it</h1>
    </div>
  </div>

  <div class="wrap body">
    <p class="lede">
      Concepts, recipes, and legacy Unity symbols. Searching something like
      <code>Input.GetAxis</code> lands on a pointer to the modern equivalent.
    </p>

    <!-- Pagefind builds its index from `dist` after `astro build`; the UI is only
         present in the built site, so `astro dev` will show an empty box. -->
    <div id="search"></div>
  </div>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search').innerHTML =
          '<p style="color:var(--n-300)">Search index not built. Run <code>npm run build</code>, ' +
          'then <code>npm run preview</code> — Pagefind indexes the built site.</p>';
        return;
      }
      new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
    });
  </script>

  <style is:global>
    /*
      Pagefind's stylesheet loads after Astro's bundle and also targets `:root`,
      so variables set there lose on source order. Scoping to `#search` (an ID,
      1-0-0) beats `:root` (0-1-0) outright, so the override no longer depends
      on load order.
    */
    #search {
      --pagefind-ui-scale: 0.95;
      --pagefind-ui-primary: var(--accent);
      --pagefind-ui-text: var(--text);
      --pagefind-ui-background: var(--bg);
      --pagefind-ui-border: var(--divider);
      --pagefind-ui-tag: var(--n-800);
      --pagefind-ui-border-width: 2px;
      --pagefind-ui-border-radius: 0px;
      --pagefind-ui-font: var(--font-body);
    }

    /* Rows separated by rules rather than cards — matches the rest of the design. */
    #search .pagefind-ui__result {
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--n-800);
      border-radius: 0;
      padding: 14px 0;
      margin: 0;
    }
    #search .pagefind-ui__result:last-of-type { border-bottom: 1px solid var(--n-800); }
    #search .pagefind-ui__result:hover { background: color-mix(in srgb, var(--text) 4%, transparent); }

    #search .pagefind-ui__result-title .pagefind-ui__result-link {
      color: var(--text);
      font-family: var(--font-heading);
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    #search .pagefind-ui__result-title .pagefind-ui__result-link:hover { color: var(--accent); }
    #search .pagefind-ui__result-excerpt { color: var(--n-300); font-size: 13px; }

    #search .pagefind-ui__result-nested .pagefind-ui__result-link { color: var(--accent-300); font-weight: 600; }
    #search .pagefind-ui__result-nested .pagefind-ui__result-link:hover { color: var(--accent); }

    /* The browser default <mark> is black-on-yellow, which fights the palette. */
    #search mark {
      background: var(--accent-900);
      color: var(--accent-200);
      font-weight: 600;
      border-radius: 0;
      padding: 0 3px;
    }

    #search .pagefind-ui__search-input {
      color: var(--text);
      background: var(--bg);
      border: 2px solid var(--divider);
      border-radius: 0;
      font-family: var(--font-body);
    }
    #search .pagefind-ui__search-input:focus { border-color: var(--accent); outline: none; }
    #search .pagefind-ui__search-input::placeholder { color: var(--n-500); }
    #search .pagefind-ui__search-clear { color: var(--n-300); background: transparent; border-radius: 0; }
    #search .pagefind-ui__message {
      color: var(--n-400);
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    #search .pagefind-ui__button {
      border-radius: 0;
      border: 2px solid var(--divider);
      color: var(--accent-300);
      background: transparent;
    }
    #search .pagefind-ui__button:hover { border-color: var(--accent); color: var(--accent); }
  </style>

  <style>
    .body { padding-block: 18px 0; }
    .band { padding-block: 26px 18px; }
  </style>
</Base>
