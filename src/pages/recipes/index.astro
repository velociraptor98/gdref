---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { RECIPE_GROUPS } from '../../content.config';
import { ENGINE_META } from '../../lib/engines';

const LABEL: Record<string, string> = {
  movement: 'Movement',
  input: 'Input',
  scene: 'Scenes & nodes',
  timing: 'Timing',
  physics: 'Physics',
  ui: 'UI',
  camera: 'Camera',
  audio: 'Audio',
  data: 'Saving & settings',
  effects: 'Effects',
  debug: 'Debugging',
};

const all = (await getCollection('recipes')).filter((r) => !r.data.draft);

// Render every body up front — they all live on this one page.
const rendered = await Promise.all(
  all.map(async (r) => ({ ...r, Content: (await render(r)).Content }))
);

const groups = RECIPE_GROUPS.map((group) => ({
  group,
  label: LABEL[group],
  items: rendered
    .filter((r) => r.data.group === group)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
})).filter((g) => g.items.length > 0);

const concepts = await getCollection('concepts');
const conceptTitle = (id: string) => concepts.find((c) => c.id === id)?.data.title ?? id;
---
<Base
  title="Godot recipes — gdref"
  description="Copy-paste solutions to the things every Godot project needs."
>
  <div class="band">
    <div class="wrap band-grid">
      <div>
        <div class="lbl crumb">Recipes</div>
        <h1>{all.length} Godot recipes</h1>
      </div>
      <span class="tag lbl tag-outline">Godot only</span>
    </div>
  </div>

  <div class="wrap intro">
    <p class="lede">
      Solutions to the things every project needs, written for
      {ENGINE_META.godot.versionFull.replace('Godot Engine ', 'Godot ')}. No comparison
      column — just code that works.
    </p>
    <nav class="jump" aria-label="Recipe categories">
      {groups.map((g) => <a href={`#${g.group}`}>{g.label}</a>)}
    </nav>
  </div>

  <div class="wrap" data-pagefind-body>
    {groups.map((g) => (
      <section class="recipe-group">
        <h2 id={g.group} class="group-head">{g.label}</h2>

        {g.items.map((r) => (
          <article class="recipe" id={r.id}>
            <div class="rhead">
              <h3>
                <a href={`#${r.id}`} class="anchor" aria-label="Link to this recipe">#</a>
                {r.data.title}
              </h3>
              <span class="lbl file mono">{r.id}.gd</span>
            </div>
            <p class="problem">{r.data.summary}</p>
            <r.Content />
            {r.data.related.length > 0 && (
              <p class="rel">
                Background:{' '}
                {r.data.related.map((id: string, i: number) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/concepts/${id}/`}>{conceptTitle(id)}</a>
                  </>
                ))}
              </p>
            )}
          </article>
        ))}
      </section>
    ))}
  </div>

  <style>
    .intro { padding-block: 16px 0; }
    .jump {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 14px 0 0;
      padding-bottom: 18px;
      border-bottom: 2px solid var(--divider);
    }
    .jump a {
      font-size: 11px;
      padding: 3px 9px;
      border: 2px solid var(--divider);
      color: var(--n-300);
      font-family: var(--font-heading);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .jump a:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }

    .group-head {
      color: var(--n-400);
      margin: 2.6rem 0 0;
      padding-bottom: 8px;
      border-bottom: 2px solid var(--divider);
      scroll-margin-top: 70px;
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .recipe-group:first-child .group-head { margin-top: 1.6rem; }

    .recipe { padding: 1.5rem 0 0.4rem; scroll-margin-top: 70px; }
    .recipe + .recipe { border-top: 1px solid var(--n-800); margin-top: 1.2rem; }
    .rhead { display: flex; align-items: baseline; gap: 12px; }
    .recipe h3 { margin: 0; font-size: 17px; }
    .file { margin-left: auto; color: var(--n-400); font-size: 10.5px; }
    .recipe .problem { color: var(--n-300); margin: 4px 0 12px; font-size: 13px; }
    .recipe :global(p) { font-size: 13.5px; color: var(--n-200); max-width: 78ch; }
    .recipe :global(pre) { margin: 12px 0; border-left-color: var(--accent); }
    .recipe :global(h3) { font-size: 14px; }

    .anchor {
      color: var(--n-600);
      text-decoration: none;
      font-weight: 400;
      margin-left: -0.9em;
      padding-right: 0.3em;
      opacity: 0;
      transition: opacity 0.12s;
    }
    .recipe:hover .anchor, .anchor:focus { opacity: 1; }
    @media (max-width: 700px) { .anchor { display: none; } .file { display: none; } }

    .rel { font-size: 12px; color: var(--n-400); margin: 0.9rem 0 0; }
  </style>
</Base>
