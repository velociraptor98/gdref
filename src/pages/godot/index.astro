---
import Base from '../../layouts/Base.astro';
import { godotApi, godotClasses } from '../../lib/engines';

const classes = godotClasses();
const singletons = classes.filter((c) => c.isSingleton);
const methods = classes.reduce((n, c) => n + c.methods.length, 0);

// Group alphabetically — 952 classes need an index, not a flat list.
const letters = [...new Set(classes.map((c) => c.name[0].toUpperCase()))].sort();
const groups = letters.map((L) => ({
  letter: L,
  items: classes.filter((c) => c.name[0].toUpperCase() === L),
}));
---
<Base
  title="Godot API — gdref"
  description={`Complete ${godotApi.versionFull} class reference, generated from the engine's API dump.`}
>
  <h1>Godot API</h1>
  <p class="lede">
    {classes.length} classes, {methods.toLocaleString()} methods, {singletons.length} singletons —
    generated from <code>extension_api.json</code> for {godotApi.versionFull}.
  </p>

  {!godotApi.hasProse && (
    <div class="callout">
      <strong>Structural reference</strong>
      Signatures, signals, properties and enums are complete. Descriptions come from the
      engine's <code>doc/classes</code> XML — re-run
      <code>npm run ingest:godot -- --docs &lt;godot&gt;/doc/classes</code> against a
      local checkout to merge them in.
    </div>
  )}

  <h2>Singletons</h2>
  <ul class="chips">
    {singletons.map((c) => <li><a href={`/godot/${c.slug}/`}>{c.name}</a></li>)}
  </ul>

  {groups.map((g) => (
    <>
      <h2 class="cat" id={g.letter}>{g.letter}</h2>
      <ul class="chips">
        {g.items.map((c) => <li><a href={`/godot/${c.slug}/`}>{c.name}</a></li>)}
      </ul>
    </>
  ))}
</Base>
