---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const legacy = await getCollection('legacy');
  return legacy.map((l) => ({ params: { id: l.id }, props: { stub: l } }));
}

const { stub } = Astro.props;
const concepts = await getCollection('concepts');
const target = concepts.find((c) => c.id === stub.data.replacedBy);
---
<Base title={`${stub.data.symbol} (legacy) — gdref`} description={stub.data.note}>
  {/*
    Deliberately thin. These exist so a reader with old code on screen finds
    something when they search the symbol they can see — they are never linked
    from tables or browse pages. See SCOPE.md.
  */}
  <article data-pagefind-body>
    <div class="band">
      <div class="wrap band-grid">
        <div>
          <div class="lbl crumb">Legacy Unity symbol</div>
          <h1 class="mono sym">{stub.data.symbol}</h1>
        </div>
        <span class="tag lbl tag-legacy">Legacy</span>
      </div>
    </div>

    <div class="wrap body">
      <p class="lede">{stub.data.note}</p>

      {target && (
        <div class="callout">
          <strong>Current equivalent</strong>
          <a href={`/concepts/${target.id}/`}>{target.data.title}</a> — {target.data.summary}
        </div>
      )}

      {stub.data.docsUrl && (
        <p class="docs">
          <a href={stub.data.docsUrl} rel="noopener nofollow" target="_blank">
            Unity's docs for the legacy API ↗
          </a>
        </p>
      )}
    </div>
  </article>

  <style>
    .sym { font-size: clamp(20px, 4vw, 32px); letter-spacing: -0.02em; word-break: break-word; }
    .body { padding-block: 18px 0; }
    .docs { font-size: 12px; margin-top: 1.2rem; }
  </style>
</Base>
